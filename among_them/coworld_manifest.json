{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/metta/main/packages/cogames/src/cogames/coworld/coworld_manifest_schema.json",
  "game": {
    "name": "among_them",
    "version": "0.1.0",
    "description": "A social deduction BitWorld game with crewmates, imposters, tasks, voting, and betrayal.",
    "owner": "treeform@softmax.com",
    "runnable": {
      "type": "game",
      "image": "bitworld-among-them:latest"
    },
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens"],
      "properties": {
        "tokens": {
          "description": "One connection token per player slot, indexed by slot.",
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 0
          },
          "default": []
        },
        "slots": {
          "description": "Optional fixed player slot settings.",
          "type": "array",
          "maxItems": 16,
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "token": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": ["crew", "imposter"]
              },
              "color": {
                "type": "string",
                "enum": [
                  "red",
                  "orange",
                  "yellow",
                  "light blue",
                  "pink",
                  "lime",
                  "blue",
                  "pale blue",
                  "gray",
                  "white",
                  "dark brown",
                  "brown",
                  "dark teal",
                  "green",
                  "dark navy",
                  "black"
                ]
              }
            }
          }
        },
        "seed": {
          "description": "Random seed.",
          "type": "integer",
          "default": 679961
        },
        "minPlayers": {
          "description": "Players needed before the game countdown starts.",
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 8
        },
        "imposterCount": {
          "description": "Fixed imposter count when autoImposterCount is false.",
          "type": "integer",
          "minimum": 0,
          "maximum": 15,
          "default": 2
        },
        "autoImposterCount": {
          "description": "Automatically choose imposter count from player count.",
          "type": "boolean",
          "default": false
        },
        "tasksPerPlayer": {
          "description": "Tasks assigned to each crewmate.",
          "type": "integer",
          "minimum": 0,
          "default": 8
        },
        "buttonCalls": {
          "description": "Emergency button calls allowed per player.",
          "type": "integer",
          "minimum": 0,
          "default": 1
        },
        "startWaitTicks": {
          "description": "Lobby countdown ticks after enough players join.",
          "type": "integer",
          "minimum": 0,
          "default": 120
        },
        "voteTimerTicks": {
          "description": "Voting phase duration in ticks.",
          "type": "integer",
          "minimum": 1,
          "default": 6000
        },
        "voteResultTicks": {
          "description": "Vote result display duration in ticks.",
          "type": "integer",
          "minimum": 0,
          "default": 72
        },
        "imposterCooldownTicks": {
          "description": "Kill cooldown duration in ticks.",
          "type": "integer",
          "minimum": 0,
          "default": 1200
        },
        "killCooldownTicks": {
          "description": "Alias for imposterCooldownTicks.",
          "type": "integer",
          "minimum": 0,
          "default": 1200
        },
        "roleRevealTicks": {
          "description": "Role reveal duration in ticks.",
          "type": "integer",
          "minimum": 0,
          "default": 120
        },
        "taskCompleteTicks": {
          "description": "Task completion duration in ticks.",
          "type": "integer",
          "minimum": 0,
          "default": 72
        },
        "messageCooldownTicks": {
          "description": "Chat message cooldown in ticks.",
          "type": "integer",
          "minimum": 0,
          "default": 100
        },
        "gameOverTicks": {
          "description": "Game over display duration in ticks.",
          "type": "integer",
          "minimum": 0,
          "default": 360
        },
        "maxTicks": {
          "description": "Maximum game ticks, where 0 means no limit.",
          "type": "integer",
          "minimum": 0,
          "default": 10000
        },
        "maxGames": {
          "description": "Maximum games before shutdown.",
          "type": "integer",
          "minimum": 0,
          "default": 1
        },
        "killRange": {
          "description": "Kill interaction range.",
          "type": "integer",
          "minimum": 0,
          "default": 20
        },
        "ventRange": {
          "description": "Vent interaction range.",
          "type": "integer",
          "minimum": 0,
          "default": 16
        },
        "reportRange": {
          "description": "Body report interaction range.",
          "type": "integer",
          "minimum": 0,
          "default": 20
        },
        "showTaskArrows": {
          "description": "Show arrows pointing to tasks.",
          "type": "boolean",
          "default": true
        },
        "showTaskBubbles": {
          "description": "Show task bubbles.",
          "type": "boolean",
          "default": true
        },
        "showPlayerLabels": {
          "description": "Show player labels.",
          "type": "boolean",
          "default": true
        },
        "mapPath": {
          "description": "Map JSON file path.",
          "type": "string",
          "default": "map.json"
        }
      }
    },
    "results_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": ["scores"],
      "properties": {
        "names": {
          "description": "One player name or address per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string"
          }
        },
        "scores": {
          "description": "One scalar score per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "number"
          }
        },
        "win": {
          "description": "One win flag per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "boolean"
          }
        },
        "tasks": {
          "description": "One completed task count per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "integer"
          }
        },
        "kills": {
          "description": "One kill count per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "integer"
          }
        },
        "imposter": {
          "description": "One 1 or 0 flag for whether the player was an imposter.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        },
        "crew": {
          "description": "One 1 or 0 flag for whether the player was crew.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        },
        "vote_players": {
          "description": "One count of votes cast for a player per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "vote_skip": {
          "description": "One count of explicit skip votes per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "vote_timeout": {
          "description": "One count of vote timeouts per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "protocols": {
      "player": "../docs/player_protocol_spec.md",
      "global": "../docs/global_protocol_spec.md"
    }
  },
  "player": [
    {
      "id": "nottoodumb",
      "name": "nottoodumb",
      "type": "player",
      "image": "bitworld-nottoodumb:latest",
      "description": "Deterministic baseline Among Them player used for local smoke episodes."
    }
  ],
  "variants": [
    {
      "id": "certification-smoke",
      "name": "Certification Smoke",
      "description": "Single-player deterministic smoke episode used by coworld certification.",
      "game_config": {
        "seed": 679961,
        "minPlayers": 1,
        "imposterCount": 0,
        "autoImposterCount": false,
        "tasksPerPlayer": 0,
        "startWaitTicks": 0,
        "roleRevealTicks": 0,
        "gameOverTicks": 1,
        "maxTicks": 240,
        "maxGames": 1,
        "voteTimerTicks": 120,
        "showTaskArrows": false,
        "showTaskBubbles": false,
        "showPlayerLabels": true,
        "slots": [
          {
            "name": "cert-player-0",
            "role": "crew",
            "color": "red"
          }
        ]
      }
    }
  ],
  "certification": {
    "variant_id": "certification-smoke",
    "players": [
      {
        "player_id": "nottoodumb",
        "initial_params": {
          "name": "cert-player-0"
        }
      }
    ]
  }
}
