{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/metta/main/packages/cogames/src/cogames/coworld/coworld_manifest_schema.json",
  "game": {
    "name": "fancy_cookout",
    "version": "0.1.0",
    "description": "A cooperative kitchen game where players wash dishes, chop ingredients, and deliver salads for points.",
    "owner": "malcolm@softmax.com",
    "image_uri": "ghcr.io/metta-ai/bitworld-fancy-cookout:latest",
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens"],
      "properties": {
        "tokens": {
          "description": "One connection token per player slot.",
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 0 },
          "default": []
        },
        "seed": {
          "description": "Random seed.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "maxTicks": {
          "description": "Maximum simulation ticks per round (24 ticks/sec), 0 = unlimited.",
          "type": "integer",
          "minimum": 0,
          "default": 7200
        },
        "maxGames": {
          "description": "Maximum fresh games before shutdown, 0 = unlimited.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "results_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": ["names", "scores"],
      "properties": {
        "names": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scores": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "protocols": {
      "player": "https://github.com/Metta-AI/bitworld/blob/master/docs/sprite_v1.md",
      "global": "https://github.com/Metta-AI/bitworld/blob/master/docs/sprite_v1.md"
    }
  },
  "player": [
    {
      "id": "chef",
      "name": "Chef",
      "image_uri": "ghcr.io/metta-ai/bitworld-fancy-cookout-chef:latest",
      "description": "Vision-based bot that navigates the kitchen, interacts with stations, and attempts to prepare salads."
    }
  ],
  "variants": [
    {
      "id": "smoke",
      "name": "Smoke",
      "game_config": {
        "seed": 0,
        "maxTicks": 480,
        "maxGames": 1
      },
      "description": "Short deterministic configuration for manifest checks."
    }
  ],
  "certification": {
    "variant_id": "smoke",
    "players": [
      {
        "player_id": "chef",
        "initial_params": { "name": "chef_0" }
      }
    ]
  }
}
