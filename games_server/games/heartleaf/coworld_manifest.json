{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/metta/main/packages/coworld/src/coworld/coworld_manifest_schema.json",
  "game": {
    "name": "heartleaf",
    "version": "0.1.0",
    "description": "A cozy BitWorld garden dinner game where players grow food, collect vegetables, and gather in the evening.",
    "owner": "treeform@softmax.com",
    "runnable": {
      "type": "game",
      "image": "public.ecr.aws/s3j4p9s7/treeform/games/heartleaf:latest",
      "run": ["/bin/heartleaf"]
    },
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens"
      ],
      "properties": {
        "tokens": {
          "description": "One connection token per player slot, indexed by slot.",
          "type": "array",
          "minItems": 0,
          "maxItems": 9,
          "items": {
            "type": "string",
            "minLength": 0
          },
          "default": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            ""
          ]
        },
        "seed": {
          "description": "Random seed.",
          "type": "integer",
          "minimum": 0,
          "default": 4731713
        },
        "maxTicks": {
          "description": "Maximum simulation ticks before starting a fresh game, where 0 means no tick limit.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "maxGames": {
          "description": "Maximum fresh games before shutdown, where 0 means no game limit.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "results_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day",
        "names",
        "usernames",
        "playerNames",
        "scores"
      ],
      "properties": {
        "day": {
          "description": "One-based Heartleaf day number for this score row.",
          "type": "integer",
          "minimum": 1
        },
        "names": {
          "description": "Player names in score order.",
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "usernames": {
          "description": "Connection usernames in score order.",
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "playerNames": {
          "description": "Fixed Heartleaf gnome names in score order.",
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "scores": {
          "description": "Cumulative player scores at the end of this day.",
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "protocols": {
      "global": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/bitworld/blob/master/docs/sprite_v1.md"
      },
      "player": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/bitworld/blob/master/docs/sprite_v1.md"
      }
    },
    "docs": {
      "readme": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-heartleaf/blob/master/README.md"
      },
      "pages": [
        {
          "id": "rules.md",
          "title": "rules.md",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-heartleaf/blob/master/docs/rules.md"
          }
        },
        {
          "id": "play_heartleaf.md",
          "title": "play_heartleaf.md",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-heartleaf/blob/master/docs/play_heartleaf.md"
          }
        }
      ]
    }
  },
  "player": [
    {
      "id": "villager",
      "name": "Villager",
      "type": "player",
      "description": "Sprite-protocol Heartleaf bot that gathers food, greets nearby gnomes, hosts dinner, and searches for active parties.",
      "image": "public.ecr.aws/s3j4p9s7/treeform/players/villager:latest",
      "run": [
        "/bin/villager"
      ]
    },
    {
      "id": "talking_villager",
      "name": "Talking Villager",
      "type": "player",
      "description": "LLM-guided Heartleaf bot that gathers food, talks to players, invites guests, and honors party commitments.",
      "image": "public.ecr.aws/s3j4p9s7/treeform/players/talking-villager:latest",
      "run": [
        "/bin/talking_villager"
      ]
    }
  ],
  "reporter": [
    {
      "id": "default-reporter",
      "name": "Default Reporter",
      "type": "reporter",
      "description": "Default Coworld reporter for generic episode artifacts.",
      "image": "public.ecr.aws/q5f4m8t9/cogames@sha256:396e56a9ba1576aecc5b9868a85fa309ea98fdbbf8d656c94ec021906197ea52"
    }
  ],
  "grader": [
    {
      "id": "bitworld-score-grader",
      "name": "BitWorld Score Grader",
      "type": "grader",
      "description": "Generic BitWorld grader that scores episode interest from score spread and game-specific activity signals.",
      "source_url": "https://github.com/Metta-AI/graders/tree/main/graders/bitworld_score/bitworld_score_grader",
      "image": "ghcr.io/metta-ai/graders-bitworld-score:latest"
    }
  ],
  "variants": [
    {
      "id": "freeplay",
      "name": "Freeplay",
      "game_config": {
        "seed": 4731713,
        "maxTicks": 0,
        "maxGames": 0
      },
      "description": "Open-ended Heartleaf configuration for local player testing."
    },
    {
      "id": "smoke",
      "name": "Smoke",
      "game_config": {
        "seed": 4731713,
        "maxTicks": 12,
        "maxGames": 0
      },
      "description": "Short deterministic Heartleaf configuration used for smoke checks."
    }
  ],
  "certification": {
    "game_config": {
      "seed": 4731713,
      "maxTicks": 1200,
      "maxGames": 0
    },
    "players": [
      {
        "player_id": "villager"
      },
      {
        "player_id": "villager"
      },
      {
        "player_id": "villager"
      },
      {
        "player_id": "villager"
      },
      {
        "player_id": "villager"
      },
      {
        "player_id": "villager"
      },
      {
        "player_id": "villager"
      },
      {
        "player_id": "villager"
      },
      {
        "player_id": "villager"
      }
    ]
  }
}
