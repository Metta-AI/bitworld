{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/metta/main/packages/coworld/cogame_manifest_schema.json",
  "name": "party_progressor",
  "version": "0.1.0",
  "description": "A cooperative BitWorld party progressor where players talk, choose tank/DPS/healer gear, and push a shared frontier to the right.",
  "owner": "treeform@softmax.com",
  "image_uri": "ghcr.io/treeform/bitworld-party-progressor:latest",
  "config_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["tokens"],
    "properties": {
      "tokens": {
        "description": "One connection token per player slot, indexed by slot.",
        "type": "array",
        "minItems": 0,
        "maxItems": 64,
        "items": {
          "type": "string",
          "minLength": 0
        },
        "default": []
      },
      "seed": {
        "description": "Random seed.",
        "type": "integer",
        "minimum": 0,
        "default": 726896
      }
    }
  },
  "results_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "names",
      "scores",
      "hearts",
      "distance_walked",
      "frontier_tiles",
      "personal_frontier_tiles",
      "roles",
      "damage_done",
      "healing_done",
      "damage_blocked",
      "messages_sent"
    ],
    "properties": {
      "names": {
        "description": "One player name or address per player slot.",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "scores": {
        "description": "Shared team frontier score per player slot.",
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "hearts": {
        "description": "One remaining life count per player slot.",
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "distance_walked": {
        "description": "One total distance walked value per player slot.",
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "frontier_tiles": {
        "description": "Shared farthest rightward progress beyond the safe origin, in tiles.",
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "personal_frontier_tiles": {
        "description": "Per-player farthest rightward progress beyond the safe origin, in tiles.",
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "roles": {
        "description": "Current role for each player slot.",
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["unarmed", "tank", "dps", "healer"]
        }
      },
      "damage_done": {
        "description": "Per-player monster damage dealt.",
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "healing_done": {
        "description": "Per-player healing applied to allies.",
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "damage_blocked": {
        "description": "Per-player damage prevented with tank guard.",
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "messages_sent": {
        "description": "Per-player public chat messages accepted by the server.",
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "protocols": {
    "player": "../docs/global_protocol_spec.md",
    "global": "../docs/global_protocol_spec.md"
  }
}
