{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/metta/main/packages/coworld/cogame_manifest_schema.json",
  "name": "planet_wars",
  "version": "0.1.0",
  "description": "A sprite-protocol BitWorld strategy game where players conquer planets and launch ships across a tiny star map.",
  "owner": "treeform@softmax.com",
  "image_uri": "bitworld-planet-wars:latest",
  "config_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["tokens"],
    "properties": {
      "tokens": {
        "description": "One connection token per player slot, indexed by slot.",
        "type": "array",
        "minItems": 0,
        "maxItems": 64,
        "items": {
          "type": "string",
          "minLength": 0
        },
        "default": []
      },
      "seed": {
        "description": "Random seed.",
        "type": "integer",
        "minimum": 0,
        "default": 108519
      },
      "planetCount": {
        "description": "Number of planets to place in the world.",
        "type": "integer",
        "minimum": 1,
        "maximum": 48,
        "default": 18
      }
    }
  },
  "results_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["names", "scores", "planets", "ships"],
    "properties": {
      "names": {
        "description": "One player name or address per player slot.",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "scores": {
        "description": "One strategy score per player slot.",
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "planets": {
        "description": "One owned planet count per player slot.",
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "ships": {
        "description": "One total owned ship count per player slot.",
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "protocols": {
    "player": "../docs/global_protocol_spec.md",
    "global": "../docs/global_protocol_spec.md"
  }
}
