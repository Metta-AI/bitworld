{
  "game": {
    "name": "mortal_coil",
    "version": "0.1.0",
    "description": "A multiplayer social negotiation game of magic, risk, and betrayal.",
    "runnable": {
      "type": "game",
      "image": "ghcr.io/treeform/bitworld-mortal-coil:latest",
      "run": ["/bin/mortal_coil", "--address:0.0.0.0", "--port:8080"]
    },
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "description": "Random seed.",
          "type": "integer",
          "default": 0
        },
        "minPlayers": {
          "description": "Players needed before the game countdown starts.",
          "type": "integer",
          "minimum": 2,
          "maximum": 8,
          "default": 4
        }
      }
    },
    "results_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scores"
      ],
      "properties": {
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scores": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "power": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "individuality": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "cooperativity": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "exploitativty": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "vicariousness": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "protocols": {
      "player": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/bitworld/blob/master/docs/sprite_v1.md"
      },
      "global": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/bitworld/blob/master/docs/sprite_v1.md"
      }
    }
  },
  "player": [
    {
      "id": "coilbot",
      "name": "coilbot",
      "type": "player",
      "description": "LLM-powered Mortal Coil bot that uses Claude to choose options."
    }
  ],
  "variants": [
    {
      "id": "default",
      "name": "Default",
      "description": "Four-player Mortal Coil game with LLM bots.",
      "game_config": {
        "seed": 0,
        "minPlayers": 4
      }
    }
  ]
}
