{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/metta/main/packages/coworld/cogame_manifest_schema.json",
  "name": "infinite_blocks",
  "version": "0.1.0",
  "description": "A multiplayer BitWorld falling-blocks game where players stack pieces, clear lines, and compete for score on one shared board.",
  "owner": "treeform@softmax.com",
  "image_uri": "bitworld-infinite-blocks:latest",
  "config_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["tokens"],
    "properties": {
      "tokens": {
        "description": "One connection token per player slot, indexed by slot.",
        "type": "array",
        "minItems": 0,
        "maxItems": 64,
        "items": {
          "type": "string",
          "minLength": 0
        },
        "default": []
      },
      "seed": {
        "description": "Random seed.",
        "type": "integer",
        "minimum": 0,
        "default": 32619276
      },
      "maxTicks": {
        "description": "Maximum simulation ticks before shutdown, where 0 means no limit.",
        "type": "integer",
        "minimum": 0,
        "default": 0
      }
    }
  },
  "results_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["names", "scores", "alive"],
    "properties": {
      "names": {
        "description": "One player name or address per player slot.",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "scores": {
        "description": "One line-clear score per player slot.",
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "alive": {
        "description": "One flag per player slot indicating whether the player can still spawn pieces.",
        "type": "array",
        "items": {
          "type": "boolean"
        }
      }
    }
  },
  "protocols": {
    "sprite_player": "sprite_protocol",
    "global": "sprite_protocol",
    "admin": "http"
  },
  "client": {
    "client/global": "sprite_protocol"
  }
}
